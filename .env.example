# Database
DATABASE_URL=postgresql://user:password@localhost:5432/manuals_db

# Optional direct URL for certain Prisma setups
DIRECT_URL=

# App
PORT=5000
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Flutterwave / Payment provider
FLW_SECRET_KEY=FLWSECK_TEST_xxx
FLW_WEBHOOK_SECRET=your_flutterwave_webhook_secret

# Resend (email) - or configure your preferred mailer
RESEND_API_KEY=your_resend_api_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seeder (optional)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_to_a_strong_password

# Optional: Redis for sessions or rate limiting
REDIS_HOST=
REDIS_PORT=

# Academic session used on receipts
ACADEMIC_SESSION=2025/2026

# Do NOT commit real secrets
# Replace placeholder values before deploying